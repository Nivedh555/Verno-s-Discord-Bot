# Copy this file to .env and fill in the values.

# Required: your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Required: PostgreSQL connection string.
# Free option: create a database at https://neon.tech and paste its URL here.
# Example: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname

# Optional: a server (guild) ID for instant slash-command sync during testing.
# Without it, global command sync can take up to an hour to appear.
DEV_GUILD_ID=

# Optional: enable the privileged Server Members intent (must also enable it in
# the Discord developer portal). Speeds up adding members to session threads.
MEMBERS_INTENT=false

# Optional: comma-separated user IDs that always sort to the front of a queue.
PRIORITY_USER_IDS=
