# Reference systemd unit. deploy-cloud.sh generates this automatically with the
# correct paths/user; this copy is for manual setups. Replace /home/ubuntu/queue-bot
# with your actual repo path and `ubuntu` with your user, then:
#   sudo cp heist-bot.service /etc/systemd/system/queue-bot.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now queue-bot

[Unit]
Description=Multi-tenant Discord Queue Bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/queue-bot
ExecStart=/home/ubuntu/queue-bot/.venv/bin/python -m bot.main
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
